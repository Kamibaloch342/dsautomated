# Qwen / DashScope — generates the secondary listing images (pl_images.py).
# Get a standard key (sk-...) from https://home.qwencloud.com/api-keys
# A Coding Plan key (sk-sp-...) will NOT work: image models are not on that plan.
# Copy this file to .env — .env is gitignored and must never be committed.
DASHSCOPE_API_KEY=sk-your-key-here
