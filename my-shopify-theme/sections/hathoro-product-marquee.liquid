{%- comment -%}
  Looping product row (14 Nov 2026, owner: "products should keep rotating, moving in a circle").
  All products of one collection (default: Best Sellers) glide left without end; the card that
  leaves on the left is moved to the back of the row (assets/hathoro-marquee.js), so every
  card exists once and its Add to cart works. Stops while the pointer or keyboard focus is on
  it, while it is off screen, and for visitors who ask for reduced motion (then it is a row you
  can scroll by hand).
{%- endcomment -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
<script src="{{ 'hathoro-marquee.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections['best-sellers']
  endif
-%}

{%- if col != blank and col.products.size > 0 -%}
  <div class="hathoro-marquee-section">
    {%- if section.settings.heading != blank -%}
      <div class="page-width">
        <div class="hathoro-marquee__head">
          <h2 class="hathoro-marquee__heading">{{ section.settings.heading | escape }}</h2>
          <a href="{{ col.url }}" class="hathoro-marquee__all">View all {{ col.all_products_count }} &rarr;</a>
        </div>
      </div>
    {%- endif -%}
    <div class="page-width">
    <hathoro-marquee class="hathoro-marquee" data-speed="{{ section.settings.speed }}" aria-label="{{ col.title | escape }}">
      <ul class="hathoro-marquee__track" role="list">
        {%- assign skip_card_product_styles = false -%}
        {%- for product in col.products limit: section.settings.max_products -%}
          <li class="hathoro-marquee__item">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: 'square',
              image_shape: 'default',
              show_secondary_image: false,
              show_vendor: true,
              show_rating: false,
              lazy_load: false,
              skip_styles: skip_card_product_styles,
              quick_add: section.settings.quick_add,
              section_id: section.id
            %}
          </li>
          {%- assign skip_card_product_styles = true -%}
        {%- endfor -%}
      </ul>
    </hathoro-marquee>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Looping product row",
  "tag": "section",
  "class": "section-hathoro-marquee",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Empty = Best Sellers."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Most products in the loop",
      "min": 6,
      "max": 50,
      "step": 1,
      "default": 30
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Speed (pixels per second)",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 40
    },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Add to cart button",
      "options": [
        { "value": "standard", "label": "Show" },
        { "value": "none", "label": "Hide" }
      ],
      "default": "standard"
    }
  ],
  "presets": [
    {
      "name": "Looping product row"
    }
  ]
}
{% endschema %}
