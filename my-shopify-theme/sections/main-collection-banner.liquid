{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{settings.media_shadow_vertical_offset | at_least: 0}}px + 2rem);
    }
  }
{%- endstyle -%}

<div class="hathoro-collection-header">
  <div class="page-width">
    <nav class="hathoro-breadcrumb" aria-label="Breadcrumb" style="padding: 0 0 1rem; border-bottom: none;">
      <ol class="hathoro-breadcrumb__list">
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="{{ routes.collections_url }}">Collections</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{{ collection.title | escape }}</li>
      </ol>
    </nav>

    <div class="hathoro-collection-header__card">
      <div class="hathoro-collection-header__main">
        <div>
          <span class="hathoro-section-eyebrow">Hathoro Commercial &amp; Industrial Catalog</span>
          <h1 class="hathoro-collection-header__title">
            {{- collection.title | escape -}}
          </h1>
          {%- if section.settings.show_collection_description and collection.description != blank -%}
            <div class="hathoro-collection-header__description rte">{{ collection.description }}</div>
          {%- else -%}
            <p class="hathoro-collection-header__description">
              Authentic OEM supplies, commercial tools, and facility equipment in stock and ready for same-day dispatch before 3:00 PM CT.
            </p>
          {%- endif -%}
        </div>
        <div class="hathoro-collection-header__meta">
          <span class="hathoro-collection-header__count">
            ● {{ collection.all_products_count }} {{ collection.all_products_count | pluralize: 'Product', 'Products' }} Available
          </span>
          <span class="hathoro-collection-header__ship">⚡ Ships Same Day Before 3PM CT</span>
        </div>
      </div>

      <!-- Dynamic Collection / Category Quick Switcher Pills -->
      <div class="hathoro-collection-pills" role="navigation" aria-label="Departments">
        <a href="{{ routes.all_products_collection_url }}" class="hathoro-collection-pill{% if collection.handle == 'all' %} hathoro-collection-pill--active{% endif %}">
          All Products
        </a>
        {%- for col in collections -%}
          {%- unless col.handle == 'frontpage' or col.handle == 'all' or col.all_products_count == 0 -%}
            <a href="{{ col.url }}" class="hathoro-collection-pill{% if collection.handle == col.handle %} hathoro-collection-pill--active{% endif %}">
              {{ col.title | escape }}
              <span class="hathoro-collection-pill__num">({{ col.all_products_count }})</span>
            </a>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
